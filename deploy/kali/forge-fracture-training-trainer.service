[Unit]
Description=Forge & Fracture security field guide
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/forge-fracture-training-site
EnvironmentFile=%h/forge-fracture-training-site/.env
ExecStart=%h/forge-fracture-training-site/scripts/run-trainer.sh
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=default.target
