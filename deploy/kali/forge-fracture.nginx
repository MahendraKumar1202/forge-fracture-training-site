# Replace both example hostnames and the private subnet with values for the
# authorized workshop network before enabling this file.
server {
    listen 80;
    listen [::]:80;
    server_name trainer.example.test;

    location / {
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name dvwb.example.test;

    # Change this to the workshop participants' actual source subnet.
    allow 127.0.0.1;
    allow ::1;
    allow 192.168.10.0/24;
    deny all;

    client_max_body_size 2m;
    location / {
        proxy_pass http://127.0.0.1:8002;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
