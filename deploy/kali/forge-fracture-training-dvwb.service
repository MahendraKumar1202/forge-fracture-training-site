[Unit]
Description=Forge & Fracture deliberately vulnerable training portal
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/forge-fracture-training-site
EnvironmentFile=%h/forge-fracture-training-site/.env
ExecStart=%h/forge-fracture-training-site/.venv/bin/uvicorn dvwb.app:app --host ${DVWB_HOST} --port ${DVWB_PORT}
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=default.target
