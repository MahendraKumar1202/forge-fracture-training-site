# Copy to .env and edit for your isolated workshop network.
# These apps are intentionally vulnerable. Do not expose them to the public internet.
TRAINER_HOST=0.0.0.0
TRAINER_PORT=8001
DVWB_HOST=0.0.0.0
DVWB_PORT=8002
# Replace with the Kali VM's participant-reachable IP address.
DVWB_PUBLIC_URL=http://192.168.10.10:8002/
# The installer replaces this with an absolute path to instance/dvwb.sqlite3.
DVWB_DATABASE_URL=sqlite:///instance/dvwb.sqlite3
